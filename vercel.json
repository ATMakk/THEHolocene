{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "my_frontend": {
      "root": "REACT/",
      "framework": "vite"
    },
    "my_backend": {
      "root": "Node/",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "my_backend" } },
    { "source": "/(.*)", "destination": { "service": "my_frontend" } }
  ]
}